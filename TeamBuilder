import React, { useState } from "react";
import { useDrop } from "react-dnd";

const TeamBuilder = ({ operators }) => {
  const [team, setTeam] = useState({ attackers: [], defenders: [] });

  const handleDrop = (role, operator) => {
    setTeam((prev) => ({
      ...prev,
      [role]: [...prev[role], operator],
    }));
  };

  const createDropZone = (role) => {
    const [{ isOver }, dropRef] = useDrop(() => ({
      accept: "operator",
      drop: (item) => handleDrop(role, item),
      collect: (monitor) => ({
        isOver: monitor.isOver(),
      }),
    }));

    return (
      <div
        ref={dropRef}
        className={`p-4 bg-gray-800 rounded-md ${isOver ? "border-2 border-green-500" : ""}`}
      >
        <h3 className="text-white">{role.charAt(0).toUpperCase() + role.slice(1)}</h3>
        {team[role].map((op) => (
          <div key={op.id} className="text-white">
            {op.name}
          </div>
        ))}
      </div>
    );
  };

  return (
    <div className="flex space-x-4">
      <div>{createDropZone("attackers")}</div>
      <div>{createDropZone("defenders")}</div>
    </div>
  );
};

export default TeamBuilder;
