const SynergyAnalysis = ({ team }) => {
  const analyzeTeam = () => {
    // Custom logic to analyze gadgets, hard breach, intel, etc.
    const analysis = {
      hardBreach: team.attackers.some(op => op.gadget === "Hard Breach"),
      intel: team.defenders.some(op => op.role === "Intel Gatherer"),
    };
    return analysis;
  };

  const analysis = analyzeTeam();

  return (
    <div className="bg-gray-700 p-4 text-white rounded-md">
      <h3>Team Analysis</h3>
      <p>Hard Breach Available: {analysis.hardBreach ? "Yes" : "No"}</p>
      <p>Intel Gatherer: {analysis.intel ? "Yes" : "No"}</p>
    </div>
  );
};
